   "source": [
    "def extraire_lignes(geom):\n",
    "    # Conserve uniquement les lignes d'une géométrie ; None si aucune\n",
    "    if geom is None or geom.is_empty:\n",
    "        return None\n",
    "    if isinstance(geom, (LineString, MultiLineString)):\n",
    "        return geom\n",
    "    if isinstance(geom, GeometryCollection):\n",
    "        lignes = []\n",
    "        for g in geom.geoms:\n",
    "            if isinstance(g, LineString):\n",
    "                lignes.append(g)\n",
    "            elif isinstance(g, MultiLineString):\n",
    "                lignes.extend(list(g.geoms))\n",
    "        if not lignes:\n",
    "            return None\n",
    "        return lignes[0] if len(lignes) == 1 else MultiLineString(lignes)\n",
    "    return None   # Points et autres types\n",
    "\n",
    "n_avant = len(gdf)\n",
    "gdf[\"geometry\"] = gdf.geometry.apply(extraire_lignes)\n",
    "gdf = gdf[gdf.geometry.notna()].copy().reset_index(drop=True)\n",
    "\n",
    "print(\"Types après nettoyage :\", gdf.geom_type.value_counts().to_dict())\n",
    "print(\"Entités supprimées :\", n_avant - len(gdf), \"| Total :\", len(gdf))   # attendu : 3 supprimées, 503\n",
    "log_etape(\"2.2 Géométries anormales retirées\", gdf)"
   ]
