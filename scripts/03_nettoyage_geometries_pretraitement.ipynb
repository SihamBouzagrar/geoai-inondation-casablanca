   ],
   "source": [
    "\"\"\"\n",
    "Entrées : couches découpées dans donnees_decoupes/casablanca_settat/osm/\n",
    "Sorties : un fichier *_clean.gpkg par couche dans donnees_traitees/casablanca_settat/\n",
    "          + rapport_pretraitement_osm.csv (traçabilité brut -> traité)\n",
    "Ordre : POI -> bâti (utilise les POI) -> landuse. Relançable sans effet de bord.\n",
    "\"\"\"\n",
    "# =====================================================\n",
    "# CONFIGURATION\n",
    "# =====================================================\n",
    "try:\n",
    "    ROOT = Path(__file__).resolve().parent.parent      # script dans scripts/\n",
    "except NameError:\n",
    "    ROOT = Path.cwd().resolve().parent                 # notebook lancé depuis scripts/\n",
    "\n",
    "DEC = ROOT / \"donnees_decoupes\" / \"casablanca_settat\" / \"osm\"\n",
    "OUT = ROOT / \"donnees_traitees\" / \"casablanca_settat_clean\"\n",
    "OUT.mkdir(parents=True, exist_ok=True)\n",
    "SUF = \"_casablanca_settat.gpkg\"\n",
    "\n",
    "F_POI    = DEC / f\"gis_osm_pois_free_1{SUF}\"\n",
    "F_BATI   = DEC / f\"gis_osm_buildings_a_free_1{SUF}\"\n",
    "F_LANDUS = DEC / f\"gis_osm_landuse_a_free_1{SUF}\"\n",
    "\n",
    "O_POI     = OUT / \"equipements_poi_casablanca_settat_clean.gpkg\"      # couche poi_filtre\n",
    "O_SECOURS = OUT / \"infrastructures_secours_clean.gpkg\"                # couche poi_secours\n",
    "O_BATI    = OUT / \"bati_casablanca_settat_clean.gpkg\"\n",
    "O_LANDUSE = OUT / \"occupation_sol_casablanca_settat_clean.gpkg\"\n",
    "\n",
    "CRS_CIBLE    = \"EPSG:26191\"     # Merchich / Nord Maroc\n",
    "SEUIL_ANNEXE = 15               # m²  (hypothèse)\n",
    "SEUIL_GRAND  = 2000             # m²  (hypothèse)\n",
    "PREDICAT_POI = \"contains\"       # ou \"intersects\" si peu de bâtiments reclassés\n",
    "\n",
    "# =====================================================\n",
    "# DICTIONNAIRES  (poids = hypothèses à justifier / tester en sensibilité)\n",
    "# =====================================================\n",
    "CAT_POI = {\n",
    "    \"secours\": ([\"fire_station\", \"police\"], 5),\n",
    "    \"sante\": ([\"hospital\", \"clinic\", \"doctors\", \"dentist\", \"pharmacy\", \"chemist\", \"nursing_home\"], 5),\n",
    "    \"education\": ([\"school\", \"kindergarten\", \"college\", \"university\", \"library\"], 4),\n",
    "    \"gouvernance\": ([\"town_hall\", \"public_building\", \"community_centre\", \"post_office\",\n",
    "                     \"consulate\", \"embassy\"], 3),\n",
    "    \"hebergement_rassemblement\": ([\"hotel\", \"hostel\", \"guesthouse\", \"motel\", \"chalet\", \"stadium\",\n",
    "                                   \"sports_centre\", \"cinema\", \"theatre\", \"shelter\", \"museum\"], 3),\n",
    "    \"commerce_essentiel\": ([\"supermarket\", \"mall\", \"marketplace\", \"department_store\",\n",
    "                            \"convenience\", \"greengrocer\", \"food_court\"], 2),\n",
    "    \"infrastructure\": ([\"comms_tower\", \"water_tower\"], 3),\n",
    "}\n",
    "LOOK_POI = {c: (cat, p) for cat, (cl, p) in CAT_POI.items() for c in cl}\n",
    "\n",
    "CAT_BATI = {\n",
    "    \"critique_secours\": ([\"police\", \"guardhouse\"], 5),\n",
    "    \"sante\": ([\"hospital\", \"clinic\"], 5),\n",
    "    \"education\": ([\"school\", \"kindergarten\", \"college\", \"university\", \"library\"], 4),\n",
    "    \"public_admin\": ([\"administrative\", \"civic\", \"public\", \"train_station\", \"transportation\",\n",
    "                      \"airport_terminal\", \"vehicle_inspection\"], 3),\n",
    "    \"residentiel\": ([\"house\", \"residential\", \"apartments\", \"detached\", \"terrace\",\n",
    "                     \"dormitory\", \"allotment_house\"], 4),\n",
    "    \"culte\": ([\"mosque\", \"church\", \"temple\", \"religious\", \"mausoleum\"], 3),\n",
    "    \"rassemblement_hebergement\": ([\"hotel\", \"cinema\", \"stadium\", \"grandstand\", \"sports_hall\",\n",
    "                                   \"sports_centre\", \"pavilion\"], 3),\n",
    "    \"commerce_bureau\": ([\"commercial\", \"retail\", \"supermarket\", \"mall\", \"office\"], 2),\n",
    "    \"industriel_logistique\": ([\"industrial\", \"factory\", \"manufacture\", \"warehouse\", \"hangar\",\n",
    "                               \"service\", \"storage_tank\", \"silo\"], 3),\n",
    "    \"agricole_annexe\": ([\"barn\", \"stable\", \"cowshed\", \"greenhouse\", \"conservatory\", \"shed\",\n",
    "                         \"garage\", \"garages\", \"carport\", \"roof\", \"kiosk\", \"toilets\", \"ger\",\n",
    "                         \"animalerie\", \"bunker\"], 1),\n",
    "}\n",
    "LOOK_BATI = {t: (c, p) for c, (ts, p) in CAT_BATI.items() for t in ts}\n",
    "EXCLURE   = {\"abandoned\", \"ruins\", \"construction\"}\n",
    "PARASITES = {\"\", \"yes\", \"q\", \"type\", \"null\", \"none\", \"nan\", \"silc\", \"frequency\"}\n",
    "\n",
    "COEF_LANDUSE = {      # (classe, coefficient de ruissellement) : ordres de grandeur usuels\n",
    "    \"commercial\": (\"impermeable\", 0.90), \"industrial\": (\"impermeable\", 0.85),\n",
    "    \"retail\": (\"impermeable\", 0.90),     \"residential\": (\"impermeable\", 0.70),\n",
    "    \"forest\": (\"permeable\", 0.20),       \"grass\": (\"permeable\", 0.30),\n",
    "    \"meadow\": (\"permeable\", 0.30),       \"farmland\": (\"permeable\", 0.35),\n",
    "    \"scrub\": (\"permeable\", 0.25),        \"park\": (\"permeable\", 0.25),\n",
    "    \"orchard\": (\"permeable\", 0.25),      \"vineyard\": (\"permeable\", 0.30),\n",
    "    \"heath\": (\"permeable\", 0.25),        \"allotments\": (\"permeable\", 0.35),\n",
    "    \"recreation_ground\": (\"permeable\", 0.30), \"cemetery\": (\"permeable\", 0.35),\n",
    "}\n",
    "DEFAUT_LANDUSE = (\"other\", 0.50)\n",
    "\n",
    "# =====================================================\n",
    "# OUTILS\n",
    "# =====================================================\n",
    "rapport = []     # traçabilité\n",
    "\n",
    "def tracer(couche, etape, n, detail=\"\"):\n",
    "    rapport.append({\"couche\": couche, \"etape\": etape, \"nombre\": n, \"detail\": detail})\n",
    "    print(f\"  [{couche}] {etape} : {n} {detail}\")\n",
    "\n",
    "def lire(chemin):\n",
    "    \"\"\"Lit un gpkg, retire les géométries vides, répare, reprojette en EPSG:26191.\"\"\"\n",
    "    g = gpd.read_file(chemin)\n",
    "    g = g[g.geometry.notna() & ~g.geometry.is_empty].copy()\n",
    "    g[\"geometry\"] = g.geometry.make_valid()\n",
    "    g = g.to_crs(CRS_CIBLE)\n",
    "    return g[g.geometry.notna() & ~g.geometry.is_empty].reset_index(drop=True)\n",
    "\n",
    "def nettoyer(t):\n",
    "    if pd.isna(t):\n",
    "        return None\n",
    "    t = str(t).strip().lower()\n",
    "    return None if t in PARASITES else t\n",
    "\n",
    "def ecrire(gdf, chemin, couche):\n",
    "    if chemin.exists():\n",
    "        chemin.unlink()                       # un fichier par couche : aucun effet sur les autres\n",
    "    gdf.to_file(chemin, layer=couche, driver=\"GPKG\")\n",
    "\n",
    "# =====================================================\n",
    "# A. POI (points uniquement)\n",
    "# =====================================================\n",
    "print(\"=== POI ===\")\n",
    "n_brut = len(gpd.read_file(F_POI))\n",
    "poi = lire(F_POI)\n",
    "poi = poi[poi.geom_type == \"Point\"][[\"osm_id\", \"fclass\", \"name\", \"geometry\"]].copy()\n",
    "tracer(\"poi\", \"brut -> points valides\", f\"{n_brut} -> {len(poi)}\")\n",
    "\n",
    "poi[\"fclass\"]    = poi[\"fclass\"].astype(\"string\").str.strip().str.lower()\n",
    "poi[\"categorie\"] = poi[\"fclass\"].map(lambda f: LOOK_POI.get(f, (None, None))[0])\n",
    "poi[\"poids\"]     = poi[\"fclass\"].map(lambda f: LOOK_POI.get(f, (None, None))[1])\n",
    "\n",
    "poi_filtre = poi[poi.categorie.notna()].copy()\n",
    "poi_filtre[\"poids\"] = poi_filtre[\"poids\"].astype(int)\n",
    "poi_secours = poi_filtre[poi_filtre.categorie == \"secours\"].copy()\n",
    "\n",
    "tracer(\"poi\", \"poi_filtre (classes utiles)\", len(poi_filtre),\n",
    "       f\"({len(poi_filtre)/len(poi):.0%} conservés)\")\n",
    "tracer(\"poi\", \"poi_secours\", len(poi_secours),\n",
    "       str(poi_secours.fclass.value_counts().to_dict()))\n",
    "print(poi_filtre.categorie.value_counts().to_string())\n",
    "if poi_secours.empty:\n",
    "    print(\"ATTENTION : aucun POI de secours, ajouter les casernes de la Protection Civile.\")\n",
    "\n",
    "ecrire(poi_filtre, O_POI, \"poi_filtre\")\n",
    "ecrire(poi_secours, O_SECOURS, \"poi_secours\")\n",
    "\n",
    "# =====================================================\n",
    "# B. BÂTI\n",
    "# =====================================================\n",
    "print(\"\\n=== BÂTI ===\")\n",
    "n_brut = len(gpd.read_file(F_BATI))\n",
    "bati = lire(F_BATI)\n",
    "bati = bati[bati.geom_type.isin([\"Polygon\", \"MultiPolygon\"])].copy()\n",
    "bati = bati[bati.geometry.area > 0].reset_index(drop=True)\n",
    "n_depart = len(bati)\n",
    "tracer(\"bati\", \"brut -> polygones valides\", f\"{n_brut} -> {n_depart}\")\n",
    "\n",
    "# 1. nettoyage du type, exclusion, catégorie, poids, surface\n",
    "bati[\"type\"] = bati[\"type\"].map(nettoyer)\n",
    "n_exclus = int(bati[\"type\"].isin(EXCLURE).sum())\n",
    "bati = bati[~bati[\"type\"].isin(EXCLURE)].reset_index(drop=True)\n",
    "tracer(\"bati\", \"exclus (abandoned/ruins/construction)\", n_exclus)\n",
    "\n",
    "bati[\"categorie\"]  = bati[\"type\"].map(lambda t: LOOK_BATI.get(t, (\"indetermine\", 2))[0])\n",
    "bati[\"poids\"]      = bati[\"type\"].map(lambda t: LOOK_BATI.get(t, (\"indetermine\", 2))[1])\n",
    "bati[\"surface_m2\"] = bati.geometry.area\n",
    "bati[\"bati_id\"]    = bati.index\n",
    "\n",
    "hors_dico = sorted(bati.loc[(bati.categorie == \"indetermine\") & bati.type.notna(), \"type\"].unique())\n",
    "tracer(\"bati\", \"indéterminés au départ\", int((bati.categorie == \"indetermine\").sum()),\n",
    "       f\"| types hors dictionnaire : {hors_dico}\")\n",
    "\n",
    "# 2. reclassement par POI contenu dans le bâtiment (poids maximal)\n",
    "cand  = bati.loc[bati.categorie == \"indetermine\", [\"bati_id\", \"geometry\"]]\n",
    "poi_j = poi_filtre[[\"categorie\", \"poids\", \"geometry\"]].rename(\n",
    "    columns={\"categorie\": \"cat_poi\", \"poids\": \"poids_poi\"})\n",
    "j = gpd.sjoin(cand, poi_j, how=\"inner\", predicate=PREDICAT_POI)\n",
    "j = (j.sort_values(\"poids_poi\", ascending=False)\n",
    "       .drop_duplicates(\"bati_id\").set_index(\"bati_id\"))\n",
    "m = (bati.categorie == \"indetermine\") & bati.bati_id.isin(j.index)\n",
    "bati.loc[m, \"categorie\"] = bati.loc[m, \"bati_id\"].map(j[\"cat_poi\"])\n",
    "bati.loc[m, \"poids\"]     = bati.loc[m, \"bati_id\"].map(j[\"poids_poi\"])\n",
    "tracer(\"bati\", \"reclassés par POI\", int(m.sum()), f\"(prédicat : {PREDICAT_POI})\")\n",
    "\n",
    "# 3. règle par surface pour le reste (hypothèse méthodologique)\n",
    "reste = bati.categorie == \"indetermine\"\n",
    "bati.loc[reste & (bati.surface_m2 < SEUIL_ANNEXE), [\"categorie\", \"poids\"]] = [\"annexe\", 1]\n",
    "reste = bati.categorie == \"indetermine\"\n",
    "bati.loc[reste & (bati.surface_m2 <= SEUIL_GRAND), [\"categorie\", \"poids\"]] = [\"residentiel_probable\", 4]\n",
    "bati.loc[reste & (bati.surface_m2 > SEUIL_GRAND),  [\"categorie\", \"poids\"]] = [\"grand_batiment\", 3]\n",
    "bati[\"poids\"] = bati[\"poids\"].astype(int)\n",
    "\n",
    "# 4. contrôles\n",
    "assert bati.categorie.notna().all() and bati.poids.notna().all(), \"NULL détecté\"\n",
    "assert not (bati.categorie == \"indetermine\").any(), \"Il reste des indéterminés\"\n",
    "assert len(bati) == n_depart - n_exclus, \"Écart sur le nombre de bâtiments\"\n",
    "tracer(\"bati\", \"bati traité (final)\", len(bati), f\"= {n_depart} - {n_exclus}\")\n",
    "\n",
    "bilan = (bati.groupby(\"categorie\")\n",
    "             .agg(nombre=(\"poids\", \"size\"), surface_m2=(\"surface_m2\", \"sum\"))\n",
    "             .round(0).sort_values(\"nombre\", ascending=False))\n",
    "print(bilan.to_string())\n",
    "\n",
    "ecrire(bati.drop(columns=[\"bati_id\"]), O_BATI, \"bati\")\n",
    "\n",
    "# =====================================================\n",
    "# C. LANDUSE\n",
    "# =====================================================\n",
    "print(\"\\n=== LANDUSE ===\")\n",
    "n_brut = len(gpd.read_file(F_LANDUS))\n",
    "lu = lire(F_LANDUS)\n",
    "lu = lu[lu.geom_type.isin([\"Polygon\", \"MultiPolygon\"])].reset_index(drop=True)\n",
    "tracer(\"landuse\", \"brut -> polygones valides\", f\"{n_brut} -> {len(lu)}\")\n",
    "\n",
    "lu = lu.drop(columns=[\"name\"], errors=\"ignore\")\n",
    "lu[\"fclass\"]        = lu[\"fclass\"].astype(\"string\").str.strip().str.lower()\n",
    "lu[\"landuse_class\"] = lu[\"fclass\"].map(lambda f: COEF_LANDUSE.get(f, DEFAUT_LANDUSE)[0])\n",
    "lu[\"coef_ruissel\"]  = lu[\"fclass\"].map(lambda f: COEF_LANDUSE.get(f, DEFAUT_LANDUSE)[1])\n",
    "lu[\"surface_m2\"]    = lu.geometry.area\n",
    "\n",
    "tracer(\"landuse\", \"répartition des classes\", len(lu), str(lu.landuse_class.value_counts().to_dict()))\n",
    "tracer(\"landuse\", \"classes 'other'\", int((lu.landuse_class == \"other\").sum()),\n",
    "       str(lu.loc[lu.landuse_class == \"other\", \"fclass\"].value_counts().to_dict()))\n",
    "assert lu.landuse_class.notna().all() and lu.coef_ruissel.notna().all()\n",
    "\n",
    "ecrire(lu, O_LANDUSE, \"landuse\")\n",
    "# =====================================================\n",
    "# RAPPORT DE TRAÇABILITÉ (affiché, non sauvegardé)\n",
    "# =====================================================\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "try:\n",
    "    from IPython.display import display\n",
    "except ImportError:\n",
    "    display = print\n",
    "\n",
    "df_rapport = pd.DataFrame(rapport)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 75)\n",
