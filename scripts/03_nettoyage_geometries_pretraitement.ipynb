    "print(\"Longueur < 5 m        :\", (gdf[\"len_m\"] < 5).sum())\n",
    "\n",
    "masque = ~dup_geom & ~dup_id & (gdf[\"len_m\"] >= 0.01)\n",
    "print(\"Supprimés (doublons / longueur nulle) :\", (~masque).sum())\n",
    "gdf = gdf[masque].copy().reset_index(drop=True)"
   ]
