   "source": [
    "def nettoyer_nom(x):\n",
    "    # Garde uniquement l'écriture latine ; renvoie None si le nom est vide\n",
    "    if x is None or (isinstance(x, float) and pd.isna(x)):\n",
    "        return None\n",
    "    s = unicodedata.normalize(\"NFC\", str(x))\n",
    "    s = re.sub(r\"[\\u2D30-\\u2D7F]+\", \" \", s)      # tifinagh\n",
    "    s = re.sub(r\"[\\u0600-\\u06FF]+\", \" \", s)      # arabe\n",
    "    s = re.sub(r\"\\s+\", \" \", s).strip(\" -/,;\")    # espaces et séparateurs parasites\n",
    "    if s == \"\" or s.lower() in (\"none\", \"nan\", \"null\"):\n",
    "        return None\n",
    "    return s\n",
    "\n",
    "gdf[\"name_clean\"] = gdf[\"name\"].apply(nettoyer_nom)\n",
    "\n",
    "print(\"Noms nuls avant :\", gdf[\"name\"].isna().sum())\n",
    "print(\"Noms nuls après :\", gdf[\"name_clean\"].isna().sum())\n",
    "\n",
    "modifies = gdf[gdf[\"name\"].notna() & (gdf[\"name\"] != gdf[\"name_clean\"])]\n",
    "print(\"Noms modifiés :\", len(modifies))\n",
    "print(modifies[[\"osm_id\", \"name\", \"name_clean\"]].head(20).to_string())"
   ]
  },
