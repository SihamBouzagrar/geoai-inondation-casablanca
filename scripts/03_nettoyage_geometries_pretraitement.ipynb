      "483  135915024  river                  Oued Cherrat  GeometryCollection\n"
     ]
    }
   ],
   "source": [
    "anormales = gdf[~gdf.geom_type.isin([\"LineString\", \"MultiLineString\"])]\n",
    "print(anormales[[\"osm_id\", \"fclass\", \"name\"]].assign(type=anormales.geom_type).to_string())"
   ]
