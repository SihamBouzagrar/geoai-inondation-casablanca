   "source": [
    "### 2.4 Points dupliqués, auto-intersections et boucles\n",
    "\n",
    "Une ligne non simple se recoupe elle-même ; une ligne fermée est une boucle (problème pour le sens d'écoulement). Aucune n'est attendue ici : la cellule sert de garde-fou."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cf75ba3e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Points dupliqués avant / après : 0 / 0\n",
      "Géométries non simples : 0\n",
      "Lignes fermées (boucles) : 0\n",
      "Entités : 502\n"
     ]
    }
   ],
   "source": [
    "def lignes_de(geom):\n",
    "    return [geom] if geom.geom_type == \"LineString\" else list(geom.geoms)\n",
    "\n",
    "def nb_points_dupliques(geom):\n",
    "    n = 0\n",
    "    for l in lignes_de(geom):\n",
    "        c = list(l.coords)\n",
    "        n += sum(1 for i in range(1, len(c)) if c[i] == c[i - 1])\n",
    "    return n\n",
    "\n",
    "# Retrait des points consécutifs identiques (la forme ne change pas)\n",
    "n_dup_avant = gdf.geometry.apply(nb_points_dupliques).sum()\n",
    "gdf[\"geometry\"] = gdf.geometry.apply(lambda g: shapely.remove_repeated_points(g, tolerance=0))\n",
    "gdf = gdf[gdf.geometry.notna() & ~gdf.geometry.is_empty].copy().reset_index(drop=True)\n",
    "gdf[\"len_m\"] = gdf.length\n",
    "\n",
    "n_non_simples = (~gdf.geometry.is_simple).sum()\n",
    "n_fermees = gdf.geometry.apply(lambda g: g.geom_type == \"LineString\" and g.is_closed).sum()\n",
    "\n",
    "print(\"Points dupliqués avant / après :\", n_dup_avant, \"/\", gdf.geometry.apply(nb_points_dupliques).sum())\n",
    "print(\"Géométries non simples :\", n_non_simples)\n",
    "print(\"Lignes fermées (boucles) :\", n_fermees)\n",
    "print(\"Entités :\", len(gdf))\n",
    "\n",
    "# Garde-fou : si une ligne non simple apparaît, s'arrêter et la contrôler\n",
    "assert n_non_simples == 0 and n_fermees == 0, \"Géométries non simples ou fermées : à contrôler\"\n",
    "log_etape(\"2.4 Points dupliqués / simplicité vérifiés\", gdf)"
   ]
  },
