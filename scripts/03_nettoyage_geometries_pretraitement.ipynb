   "source": [
    "SEUIL_COURT = 5.0     # m : segment considéré comme \"court\"\n",
    "SEUIL_ISOLE = 1.0     # m : une extrémité à plus de 1 m du réseau n'est pas connectée\n",
    "\n",
    "courts = gdf[gdf[\"len_m\"] < SEUIL_COURT].copy()\n",
    "reseau = shapely.union_all(gdf.loc[gdf[\"len_m\"] >= SEUIL_COURT, \"geometry\"].values)\n",
    "\n",
    "def extremites(geom):\n",
    "    lignes = [geom] if geom.geom_type == \"LineString\" else list(geom.geoms)\n",
    "    pts = []\n",
    "    for l in lignes:\n",
    "        pts += [Point(l.coords[0]), Point(l.coords[-1])]\n",
    "    return pts\n",
    "\n",
    "courts[\"dist_min_reseau\"] = courts.geometry.apply(\n",
    "    lambda g: min(p.distance(reseau) for p in extremites(g))\n",
    ").round(2)\n",
    "\n",
    "print(courts[[\"osm_id\", \"fclass\", \"name_clean\", \"len_m\", \"dist_min_reseau\"]].to_string())\n",
    "\n",
    "# Segments isolés : aucune de leurs extrémités ne touche le réseau\n",
    "a_supprimer = courts.loc[courts[\"dist_min_reseau\"] > SEUIL_ISOLE, \"osm_id\"].astype(str).tolist()\n",
    "print(\"\\nSegments courts isolés supprimés :\", a_supprimer)   # attendu : ['1332404441']\n",
    "\n",
    "n_avant = len(gdf)\n",
    "gdf = gdf[~gdf[\"osm_id\"].astype(str).isin(a_supprimer)].copy().reset_index(drop=True)   # osm_id est du texte\n",
    "gdf[\"len_m\"] = gdf.length\n",
    "\n",
    "print(\"Avant :\", n_avant, \"| Après :\", len(gdf))                 # attendu : 503 -> 502\n",
    "print(\"Segments < 5 m restants (tous connectés) :\", (gdf[\"len_m\"] < SEUIL_COURT).sum())\n",
    "log_etape(\"2.3 Doublons et segments isolés retirés\", gdf)"
   ]
