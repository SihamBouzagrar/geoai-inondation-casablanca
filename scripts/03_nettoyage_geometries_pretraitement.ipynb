   "source": [
    "# --- Contrôles de conformité (OK / ECHEC)\n",
    "df_journal = pd.DataFrame(journal)\n",
    "long_filtre = df_journal.loc[df_journal[\"etape\"].str.startswith(\"3.1\"), \"longueur_km\"].iloc[0]\n",
    "long_nodage = df_journal.loc[df_journal[\"etape\"].str.startswith(\"4.3\"), \"longueur_km\"].iloc[0]\n",
    "\n",
    "controles = {\n",
    "    \"CRS = EPSG:26191\": apres.crs.to_epsg() == 26191,\n",
    "    \"Uniquement des LineString\": set(apres.geom_type.unique()) == {\"LineString\"},\n",
    "    \"Aucune géométrie nulle ou vide\": bool(apres.geometry.notna().all() and (~apres.geometry.is_empty).all()),\n",
    "    \"Aucune géométrie invalide\": bool(apres.geometry.is_valid.all()),\n",
    "    \"uid unique\": bool(apres[\"uid\"].is_unique),\n",
    "    \"Aucun doublon de géométrie\": not apres.geometry.apply(lambda g: g.wkb).duplicated().any(),\n",
    "    \"Aucune longueur nulle\": bool((apres[\"len_m\"] > 0).all()),\n",
    "    \"Classes valides (river, stream, canal, drain)\": bool(apres[\"fclass\"].isin(ORDRE_CLASSES).all()),\n",
    "    \"type_trace renseigné partout\": bool(apres[\"type_trace\"].notna().all()),\n",
    "    \"Longueur conservée par le nodage (écart < 1 m)\": abs(long_nodage - long_filtre) < 0.001,\n",
    "    \"Aucun champ de contrôle dans la couche finale\": \"dangle_proche\" not in apres.columns,\n",
    "}\n",
    "for k, v in controles.items():\n",
    "    print((\"OK    \" if v else \"ECHEC \"), k)\n",
    "print()\n",
    "print(\"Résultat global :\", \"TOUT EST CONFORME\" if all(controles.values()) else \"VERIFIER LES ECHECS CI-DESSUS\")"
   ]
